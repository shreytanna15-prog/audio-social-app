    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-thinking-orbs": "^0.2.1",
    "expo-web-browser": "~56.0.5",
    "input-monitor": "file:modules/input-monitor",
    "lucide-react-native": "^1.47.0",
    "nativewind": "^5.0.0-preview.4",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.85.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "superpowered-audio": "file:./modules/superpowered-audio",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "~19.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "patch-package": "^8.0.1",
    "playwright": "^1.65.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "node init && cross-env APP_VARIANT=development expo start --dev-client",
    "start:dev": "node init && cross-env APP_VARIANT=development expo start --dev-client",
    "android": "npm run android:dev",
    "android:dev": "cross-env APP_VARIANT=development expo prebuild --platform android --clean && cross-env APP_VARIANT=development expo run:android --device",
    "android:prod": "cross-env APP_VARIANT=production expo prebuild --platform android --clean && cross-env APP_VARIANT=production expo run:android --variant release --device",
    "postinstall": "patch-package && node ./scripts/clean-onnxruntime-native-cache.js",
    "reset-project": "node ./scripts/reset-project.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/features/profile/utils src/features/home/utils/greeting.test.ts src/features/users/api/service.test.ts src/features/explore/data/search-tabs.test.ts src/features/audio/store/input-monitor.store.test.ts src/features/projects src/features/studio/store/studio-project-context.store.test.ts src/features/player/utils/map-comment-to-player-comment.test.ts",
    "test:integration": "vitest run src/features/users/api/follow-cache.integration.test.ts src/features/audio/services/input-monitor.service.test.ts src/features/audio/services/expo-pcm-capture.monitor.integration.test.ts",
    "test:e2e": "maestro test e2e/maestro/search-follow.yaml",
    "test:e2e:library": "maestro test e2e/maestro/post-cold-library.yaml",
    "test:e2e:projects": "maestro test e2e/maestro/projects-library.yaml",
    "test:e2e:monitor": "maestro test e2e/maestro/input-monitor.yaml",
    "test:e2e:adb": "powershell -ExecutionPolicy Bypass -File ./scripts/e2e-android-smoke.ps1",
    "test:ui:web": "node ./scripts/capture-web-ui-screenshots.mjs",
    "android:run": "cross-env APP_VARIANT=development expo run:android --device Pixel_7"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-audio"
      ]
    }
  },
  "private": true,
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true
  }
}
