{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "input-monitor": [
        "./modules/input-monitor/index.ts"
      ],
      "input-monitor/*": [
        "./modules/input-monitor/*"
      ],
      "superpowered-audio": [
        "./modules/superpowered-audio/index.ts"
      ],
      "superpowered-audio/*": [
        "./modules/superpowered-audio/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
