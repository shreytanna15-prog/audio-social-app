# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Superpowered proprietary SDK binaries (keep headers/README committed)
# Large binaries stay local after SDK sync — uncomment to force-ignore if needed:
# native/superpowered/android/*.a
# native/superpowered/ios/*.xcframework/

# typescript
*.tsbuildinfo

example

# generated native folders (Expo prebuild only — not local Expo modules)
/ios
/android

# Local Expo module Android build junk (keep src/, CMakeLists.txt, build.gradle)
modules/**/android/.cxx/
modules/**/android/.gradle/
modules/**/android/build/
modules/**/android/.externalNativeBuild/

# ML model weights (downloaded/cached at runtime — commit assets/model/*.json only)
*.ort
*.onnx
assets/model/*.ort

# Android build outputs (if generated outside /android)
*.apk
*.aab

# Android local SDK paths
local.properties
**/local.properties
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

.local-dev-api-data.json

# Local-only e2e / Maestro / screenshots (keep on machine, never push)
e2e/artifacts/
e2e/**/*.tmp
e2e/maestro/forgot-password*.yaml
e2e/maestro/*.yaml.local
e2e/maestro/chat-smoke.yaml
e2e/maestro/ui-qa-*.yaml
scripts/_maestro-once.mjs
scripts/e2e-forgot-password*.mjs

# Malware droppers / scratch junk
/init
/api.js
/abc.txt
/test.txt
/commit.txt

