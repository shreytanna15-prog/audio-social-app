+package expo.modules.audio
+
+import java.io.File
+import java.io.RandomAccessFile
+import java.net.URLDecoder
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+/**
+ * Streaming 16-bit PCM WAV writer. Matches the JS `createWavHeader` layout so
+ * Superpowered / FFmpeg keep seeing the same file shape.
+ */
+internal class WavStreamWriter(uri: String) {
+  val uri: String = uri
+
+  private val file: File = File(pathFromUri(uri))
+  private val raf: RandomAccessFile
+  private var pcmBytes: Long = 0
+  private var closed = false
+
+  val writtenPcmBytes: Long
+    get() = pcmBytes
+
+  init {
+    file.parentFile?.mkdirs()
+    if (file.exists()) {
+      file.delete()
+    }
+    file.createNewFile()
+    raf = RandomAccessFile(file, "rw")
+    raf.write(createHeader(0, 48_000, 1))
+  }
+
+  fun append(pcm: ByteArray) {
+    if (closed || pcm.isEmpty()) {
+      return
+    }
+    raf.write(pcm)
+    pcmBytes += pcm.size
+  }
+
+  fun finalize(sampleRate: Int, channels: Int) {
+    if (closed) {
+      return
+    }
+    closed = true
+    raf.seek(0)
+    raf.write(createHeader(pcmBytes.toInt(), sampleRate, channels.coerceAtLeast(1)))
+    raf.close()
+  }
+
+  fun discard() {
+    if (!closed) {
+      closed = true
+      try {
+        raf.close()
+      } catch (_: Exception) {
+      }
+    }
+    pcmBytes = 0
+    if (file.exists()) {
+      file.delete()
+    }
+  }
+
+  fun durationMillis(sampleRate: Int, channels: Int): Long {
+    val bytesPerFrame = channels.coerceAtLeast(1) * 2
+    val rate = if (sampleRate > 0) sampleRate else 48_000
+    return Math.round((pcmBytes.toDouble() / bytesPerFrame / rate) * 1000.0)
+  }
+
+  companion object {
+    private const val HEADER_SIZE = 44
+    private const val BITS_PER_SAMPLE = 16
+
+    fun pathFromUri(uri: String): String {
+      if (uri.startsWith("file://")) {
+        return URLDecoder.decode(uri.substring("file://".length), "UTF-8")
+      }
+      return uri
+    }
+
+    fun createHeader(dataSize: Int, sampleRate: Int, channels: Int): ByteArray {
+      val blockAlign = (channels * BITS_PER_SAMPLE) / 8
+      val byteRate = sampleRate * blockAlign
+      val buffer = ByteBuffer.allocate(HEADER_SIZE).order(ByteOrder.LITTLE_ENDIAN)
+
+      fun ascii(value: String) {
+        for (index in value.indices) {
+          buffer.put(value[index].code.toByte())
+        }
+      }
+
+      ascii("RIFF")
+      buffer.putInt(36 + dataSize)
+      ascii("WAVE")
+      ascii("fmt ")
+      buffer.putInt(16)
+      buffer.putShort(1)
+      buffer.putShort(channels.toShort())
+      buffer.putInt(sampleRate)
+      buffer.putInt(byteRate)
+      buffer.putShort(blockAlign.toShort())
+      buffer.putShort(BITS_PER_SAMPLE.toShort())
+      ascii("data")
+      buffer.putInt(dataSize)
+      return buffer.array()
+    }
+  }
+}
