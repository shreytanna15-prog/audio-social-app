+    le16(20, 1)
+    le16(22, channels)
+    le32(24, sampleRate)
+    le32(28, byteRate)
+    le16(32, blockAlign)
+    le16(34, bitsPerSample)
+    ascii(36, "data")
+    le32(40, dataSize)
