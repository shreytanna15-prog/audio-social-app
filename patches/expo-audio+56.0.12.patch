+import Foundation
+
+/// Streaming 16-bit PCM WAV writer. Matches the JS `createWavHeader` layout.
+final class WavStreamWriter {
+  let uri: String
+
+  private let url: URL
+  private var handle: FileHandle?
+  private var pcmBytes: Int = 0
+  private var closed = false
+
+  var writtenPcmBytes: Int { pcmBytes }
+
+  init(uri: String) throws {
+    self.uri = uri
+    self.url = Self.urlFrom(uri: uri)
+
+    let directory = url.deletingLastPathComponent()
+    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+
+    if FileManager.default.fileExists(atPath: url.path) {
+      try FileManager.default.removeItem(at: url)
+    }
+
+    FileManager.default.createFile(atPath: url.path, contents: nil)
+    let handle = try FileHandle(forWritingTo: url)
+    try handle.write(contentsOf: Self.createHeader(dataSize: 0, sampleRate: 48_000, channels: 1))
+    self.handle = handle
+  }
+
+  func append(_ pcm: Data) {
+    guard !closed, !pcm.isEmpty, let handle else { return }
+    do {
+      try handle.write(contentsOf: pcm)
+      pcmBytes += pcm.count
+    } catch {
+      // Keep capturing; JS abort/stop will close the handle.
+    }
+  }
+
+  func finalize(sampleRate: Int, channels: Int) {
+    guard !closed else { return }
+    closed = true
+    guard let handle else { return }
+    do {
+      try handle.seek(toOffset: 0)
+      try handle.write(contentsOf: Self.createHeader(
+        dataSize: pcmBytes,
+        sampleRate: sampleRate,
+        channels: max(channels, 1)
+      ))
+      try handle.close()
+    } catch {
+      try? handle.close()
+    }
+    self.handle = nil
+  }
+
+  func discard() {
+    if !closed {
+      closed = true
+      try? handle?.close()
+      handle = nil
+    }
+    pcmBytes = 0
+    try? FileManager.default.removeItem(at: url)
+  }
+
+  func durationMillis(sampleRate: Int, channels: Int) -> Double {
+    let bytesPerFrame = Double(max(channels, 1) * 2)
+    let rate = sampleRate > 0 ? Double(sampleRate) : 48_000
+    return (Double(pcmBytes) / bytesPerFrame / rate) * 1000.0
+  }
+
+  private static func urlFrom(uri: String) -> URL {
+    if let parsed = URL(string: uri), parsed.isFileURL {
+      return parsed
+    }
+    return URL(fileURLWithPath: uri)
+  }
+
+  private static func createHeader(dataSize: Int, sampleRate: Int, channels: Int) -> Data {
+    let bitsPerSample = 16
+    let blockAlign = (channels * bitsPerSample) / 8
+    let byteRate = sampleRate * blockAlign
