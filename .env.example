# Superpowered (Evaluation key is OK for development builds)
# Register at https://superpowered.com/ then paste the key below.
EXPO_PUBLIC_SUPERPOWERED_LICENSE_KEY=

# Backend API (use your machine LAN IP on a physical device, not localhost)
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3015

# Dev only: skip onboarding + login. Never set true in production builds.
EXPO_PUBLIC_SKIP_AUTH=false
